# Kopírujte jako .env a vyplňte. Soubor .env NIKDY necommitujte.

# --- databáze ---------------------------------------------------------
POSTGRES_PASSWORD=zmente-me-na-dlouhe-nahodne-heslo

# --- aplikace ---------------------------------------------------------
# Náhodný klíč: openssl rand -hex 32
SECRET_KEY=zmente-me-na-nahodny-retezec-alespon-32-znaku
# Veřejná adresa aplikace (HTTPS). Používá se pro přesměrování po přihlášení školním účtem.
FRONTEND_URL=https://checkin.skola.cz
# Port na hostiteli, kde běží nginx (před ním typicky HTTPS reverzní proxy)
HTTP_PORT=8080

# Délky a limity (výchozí hodnoty stačí)
QR_WINDOW_SECONDS=15
CODE_TTL_SECONDS=60
LATE_MINUTES=10
ABSENCE_LIMIT=2
TOKEN_TTL_HOURS=12
MAX_UPLOAD_BYTES=5242880

# --- přihlášení školním účtem (OpenID Connect), volitelné --------------
# OIDC_ISSUER=https://idp.skola.cz
# OIDC_CLIENT_ID=checkin
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://checkin.skola.cz/api/auth/sso/callback
# SSO_ALLOWED_DOMAIN=skola.cz
# SSO_PASSWORD_LOGIN=1

# --- mobilní upozornění (Web Push), volitelné ---------------------------
# Vygenerujte: docker compose run --rm backend python -m app.cli vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:spravce@skola.cz
